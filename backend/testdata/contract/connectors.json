{
 "connectors": [
  {
   "descriptor": {
    "supports_masking": true,
    "kind": "source",
    "type": "postgresql",
    "title": "PostgreSQL",
    "description": "PostgreSQL 12+ using logical decoding (pgoutput). Self-hosted, RDS, Cloud SQL, Azure.",
    "presets": [
     {
      "id": "self_hosted",
      "title": "Self-hosted",
      "defaults": {},
      "note": ""
     },
     {
      "id": "aws_rds",
      "title": "AWS RDS / Aurora",
      "defaults": {
       "ssl_mode": "require"
      },
      "note": "Logical replication is a parameter-group setting (rds.logical_replication)."
     },
     {
      "id": "gcp_cloudsql",
      "title": "Google Cloud SQL / AlloyDB",
      "defaults": {
       "ssl_mode": "require"
      },
      "note": "Logical decoding is the cloudsql.logical_decoding database flag."
     },
     {
      "id": "azure_flexible",
      "title": "Azure Database for PostgreSQL",
      "defaults": {
       "ssl_mode": "require"
      },
      "note": "Set wal_level=logical in server parameters."
     }
    ],
    "config_schema": {
     "properties": {
      "host": {
       "maxLength": 255,
       "minLength": 1,
       "title": "Host",
       "type": "string",
       "ui": {
        "group": "Connection",
        "placeholder": "orders-db.internal"
       }
      },
      "port": {
       "default": 5432,
       "maximum": 65535,
       "minimum": 1,
       "title": "Port",
       "type": "integer",
       "ui": {
        "group": "Connection"
       }
      },
      "database": {
       "maxLength": 63,
       "minLength": 1,
       "title": "Database",
       "type": "string",
       "ui": {
        "group": "Connection",
        "placeholder": "app"
       }
      },
      "user": {
       "maxLength": 63,
       "minLength": 1,
       "title": "User",
       "type": "string",
       "ui": {
        "group": "Credentials",
        "placeholder": "cdc_reader"
       }
      },
      "ssl_mode": {
       "default": "prefer",
       "enum": [
        "disable",
        "prefer",
        "require",
        "verify-ca",
        "verify-full"
       ],
       "title": "TLS",
       "type": "string",
       "ui": {
        "group": "Security",
        "help": "Use verify-full in production."
       }
      },
      "ssh_host": {
       "default": "",
       "maxLength": 255,
       "title": "SSH bastion host",
       "type": "string",
       "ui": {
        "expert": true,
        "group": "SSH tunnel",
        "help": "Reach the database through this host. Empty: connect directly."
       }
      },
      "ssh_port": {
       "default": 22,
       "maximum": 65535,
       "minimum": 1,
       "title": "SSH port",
       "type": "integer",
       "ui": {
        "expert": true,
        "group": "SSH tunnel"
       }
      },
      "ssh_user": {
       "default": "",
       "maxLength": 100,
       "title": "SSH user",
       "type": "string",
       "ui": {
        "expert": true,
        "group": "SSH tunnel"
       }
      },
      "ssh_host_key": {
       "default": "",
       "maxLength": 2000,
       "title": "Bastion host key",
       "type": "string",
       "ui": {
        "expert": true,
        "group": "SSH tunnel",
        "help": "The bastion's public host key (from ssh-keyscan). Recommended: without it any key is accepted.",
        "placeholder": "ssh-ed25519 AAAA…"
       }
      }
     },
     "required": [
      "host",
      "database",
      "user"
     ],
     "title": "PostgresConfig",
     "type": "object"
    },
    "secret_schema": {
     "properties": {
      "password": {
       "maxLength": 1024,
       "minLength": 1,
       "title": "Password",
       "type": "string",
       "ui": {
        "group": "Credentials"
       }
      },
      "ssl_root_cert": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "CA certificate (PEM)",
       "ui": {
        "expert": true,
        "group": "Security",
        "multiline": true
       }
      },
      "ssh_private_key": {
       "anyOf": [
        {
         "maxLength": 20000,
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "SSH private key",
       "ui": {
        "expert": true,
        "group": "SSH tunnel",
        "help": "OpenSSH or PEM, without a passphrase.",
        "multiline": true
       }
      }
     },
     "required": [
      "password"
     ],
     "title": "PostgresSecrets",
     "type": "object"
    }
   },
   "debezium_name": "io.debezium.connector.postgresql.PostgresConnector",
   "needs_schema_history": false,
   "tracks_schema": true,
   "supports_canary": true,
   "unwrap_transform": "io.debezium.transforms.ExtractNewRecordState"
  },
