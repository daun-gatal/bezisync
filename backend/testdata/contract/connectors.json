  {
   "descriptor": {
    "supports_masking": false,
    "kind": "source",
    "type": "mongodb",
    "title": "MongoDB",
    "description": "MongoDB 6+ replica sets and sharded clusters (including Atlas) via change streams.",
    "presets": [
     {
      "id": "self_hosted",
      "title": "Self-hosted replica set",
      "defaults": {},
      "note": ""
     },
     {
      "id": "atlas",
      "title": "MongoDB Atlas",
      "defaults": {
       "srv": true,
       "tls": true
      },
      "note": ""
     },
     {
      "id": "sharded",
      "title": "Sharded cluster (mongos)",
      "defaults": {},
      "note": ""
     }
    ],
    "config_schema": {
     "properties": {
      "hosts": {
       "maxLength": 2000,
       "minLength": 3,
       "title": "Hosts",
       "type": "string",
       "ui": {
        "group": "Connection",
        "help": "Replica-set members or mongos routers.",
        "placeholder": "mongo-1:27017,mongo-2:27017"
       }
      },
      "replica_set": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "title": "Replica set name",
       "ui": {
        "group": "Connection",
        "placeholder": "rs0"
       }
      },
      "user": {
       "maxLength": 200,
       "minLength": 1,
       "title": "User",
       "type": "string",
       "ui": {
        "group": "Credentials",
        "placeholder": "cdc_reader"
       }
      },
      "auth_source": {
       "default": "admin",
       "title": "Auth Source",
       "type": "string",
       "ui": {
        "expert": true,
        "group": "Credentials"
       }
      },
      "tls": {
       "default": false,
       "title": "TLS",
       "type": "boolean",
       "ui": {
        "group": "Security"
       }
      },
      "srv": {
       "default": false,
       "title": "Use mongodb+srv:// (Atlas)",
       "type": "boolean",
       "ui": {
        "group": "Connection"
       }
      },
      "capture_full_documents": {
       "default": "change_streams_update_full",
       "enum": [
        "change_streams_update_full",
        "change_streams",
        "change_streams_with_pre_image",
        "change_streams_update_full_with_pre_image"
       ],
       "title": "Update events contain",
       "type": "string",
       "ui": {
        "expert": true,
        "group": "Events",
        "help": "change_streams_update_full: the whole document after each update."
       }
      }
     },
     "required": [
      "hosts",
      "user"
     ],
     "title": "MongoConfig",
     "type": "object"
    },
    "secret_schema": {
     "properties": {
      "password": {
       "maxLength": 1024,
       "minLength": 1,
       "title": "Password",
       "type": "string",
       "ui": {
        "group": "Credentials"
       }
      }
     },
     "required": [
      "password"
     ],
     "title": "MongoSecrets",
     "type": "object"
    }
